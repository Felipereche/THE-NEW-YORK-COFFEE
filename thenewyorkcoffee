    <!-- Notificação Flutuante (Toast) -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 bg-caramel text-espressoBg px-4 py-3 rounded-xl shadow-xl text-xs font-bold tracking-wider uppercase transform translate-y-20 opacity-0 transition-all duration-300">
        Copiado!
    </div>

    <!-- JavaScript -->
    <script>
        // Menu Mobile Toggle
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        mobileBtn.addEventListener('click', () => mobileMenu.classList.toggle('hidden'));
        mobileMenu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
        });

        // Toast Helper
        function showToast(message) {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => toast.classList.add('translate-y-20', 'opacity-0'), 2600);
        }

        // Copiar telefone
        function copyText(text, message) {
            const tempInput = document.createElement('input');
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);
            showToast(message);
        }

        // Comanda Interativa ao clicar nos itens do cardápio
        let comanda = [];

        function addToComanda(name, price) {
            comanda.push({ name, price });
            updateComandaUI();
            showToast(`+ ${name} adicionado à comanda`);
        }

        function clearComanda() {
            comanda = [];
            updateComandaUI();
        }

        function updateComandaUI() {
            document.getElementById('comanda-badge').textContent = comanda.length;
            const list = document.getElementById('comanda-items');
            const totalEl = document.getElementById('comanda-total');

            if (comanda.length === 0) {
                list.innerHTML = '<p class="text-mutedSand text-center py-6">Clique em qualquer item do cardápio para adicionar aqui.</p>';
                totalEl.textContent = 'R$ 0,00';
                return;
            }

            let total = 0;
            list.innerHTML = comanda.map((item, idx) => {
                total += item.price;
                return `
                    <div class="flex justify-between items-center bg-espressoBg/70 px-3 py-2 rounded-lg border border-caramel/15">
                        <span class="font-medium text-creamText">${item.name}</span>
                        <div class="flex items-center gap-3">
                            <span class="font-condensed text-caramelLight">R$${item.price.toFixed(2).replace('.', ',')}</span>
                            <button onclick="comanda.splice(${idx}, 1); updateComandaUI();" class="text-mutedSand hover:text-red-400 font-bold">&times;</button>
                        </div>
                    </div>
                `;
            }).join('');

            totalEl.textContent = 'R$ ' + total.toFixed(2).replace('.', ',');
        }

        function openComandaModal() {
            document.getElementById('comanda-modal').classList.remove('hidden');
        }
        function closeComandaModal() {
            document.getElementById('comanda-modal').classList.add('hidden');
        }

        function sendComandaWhatsApp() {
            if (comanda.length === 0) {
                showToast('Adicione pelo menos um item primeiro!');
                return;
            }
            const lines = comanda.map(i => `• ${i.name} (R$${i.price.toFixed(2).replace('.', ',')})`).join('%0A');
            const total = comanda.reduce((acc, i) => acc + i.price, 0).toFixed(2).replace('.', ',');
            const msg = `Olá, The New York Coffee! Gostaria de pedir:%0A%0A${lines}%0A%0A*Total estimado: R$${total}*`;
            window.open(`https://wa.me/5511914081968?text=${msg}`, '_blank');
        }

        // Tornar todos os itens do cardápio clicáveis para adicionar à comanda
        document.querySelectorAll('#menu-container .menu-item').forEach(el => {
            el.classList.add('cursor-pointer', 'hover:bg-caramel/10', 'px-2', 'py-1', '-mx-2', 'rounded-lg', 'transition');
            el.addEventListener('click', () => {
                const titleEl = el.querySelector('span:first-child') || el.querySelector('p:first-child');
                const priceEl = el.querySelector('.font-condensed');
                if (!titleEl) return;
                const name = titleEl.textContent.trim();
                let price = 0;
                if (priceEl) {
                    const match = priceEl.textContent.match(/(\d+)[,.](\d+)/);
                    if (match) price = parseFloat(`${match[1]}.${match[2]}`);
                    else {
                        const intMatch = priceEl.textContent.match(/(\d+)/);
                        if (intMatch) price = parseFloat(intMatch[1]);
                    }
                }
                addToComanda(name, price);
            });
        });

        // Filtro por Categoria e Busca em Tempo Real no Cardápio
        const filterBtns = document.querySelectorAll('.filter-btn');
        const categoryBlocks = document.querySelectorAll('.menu-category-block');
        const searchInput = document.getElementById('menu-search');
        const noResults = document.getElementById('no-results');

        let activeFilter = 'all';

        function applyFilters() {
            const query = searchInput.value.toLowerCase().trim();
            let visibleBlocks = 0;

            categoryBlocks.forEach(block => {
                const category = block.getAttribute('data-category');
                const matchesCategory = (activeFilter === 'all' || category === activeFilter);
                
                if (!matchesCategory) {
                    block.classList.add('hidden');
                    return;
                }

                const items = block.querySelectorAll('.menu-item');
                let hasVisibleItem = false;

                items.forEach(item => {
                    const text = item.textContent.toLowerCase();
                    if (query === '' || text.includes(query)) {
                        item.classList.remove('hidden');
                        hasVisibleItem = true;
                    } else {
                        item.classList.add('hidden');
                    }
                });

                if (hasVisibleItem) {
                    block.classList.remove('hidden');
                    visibleBlocks++;
                } else {
                    block.classList.add('hidden');
                }
            });

            noResults.classList.toggle('hidden', visibleBlocks > 0);
        }

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                filterBtns.forEach(b => {
                    b.classList.remove('bg-caramel', 'text-espressoBg', 'font-bold');
                    b.classList.add('border', 'border-caramel/30', 'text-creamText');
                });
                btn.classList.add('bg-caramel', 'text-espressoBg', 'font-bold');
                btn.classList.remove('border', 'border-caramel/30', 'text-creamText');

                activeFilter = btn.getAttribute('data-filter');
                applyFilters();
            });
        });

        searchInput.addEventListener('input', applyFilters);

        // =========================================================================
        // CENA 3D INTERATIVA COM ROLAGEM (THREE.JS) — XÍCARA TNYC & GRÃOS DE CAFÉ
        // =========================================================================
        function initThreeScrollScene() {
            const container = document.getElementById('three-scroll-container');
            if (!container || typeof THREE === 'undefined') return;

            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(42, window.innerWidth / window.innerHeight, 0.1, 100);
            camera.position.set(0, 0.4, 7.8);

            const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            container.appendChild(renderer.domElement);

            const ambientLight = new THREE.AmbientLight(0xffe9d2, 0.65);
            scene.add(ambientLight);

            const keyLight = new THREE.DirectionalLight(0xffd7ad, 1.35);
            keyLight.position.set(5, 8, 6);
            scene.add(keyLight);

            const rimLight = new THREE.DirectionalLight(0xA67B5B, 0.95);
            rimLight.position.set(-6, -3, 4);
            scene.add(rimLight);

            const heroGroup = new THREE.Group();
            scene.add(heroGroup);

            const cupMat = new THREE.MeshStandardMaterial({
                color: 0x1D1510,
                roughness: 0.25,
                metalness: 0.2
            });
            const goldRimMat = new THREE.MeshStandardMaterial({
                color: 0xC89D7C,
                roughness: 0.25,
                metalness: 0.85
            });
            const coffeeLiquidMat = new THREE.MeshStandardMaterial({
                color: 0x5A351E,
                roughness: 0.2,
                metalness: 0.1
            });
            const saucerMat = new THREE.MeshStandardMaterial({
                color: 0x261B14,
                roughness: 0.35,
                metalness: 0.15
            });

            const cupPoints = [
                new THREE.Vector2(0.0, -0.85),
                new THREE.Vector2(0.62, -0.85),
                new THREE.Vector2(0.75, -0.65),
                new THREE.Vector2(0.95, 0.15),
                new THREE.Vector2(1.02, 0.65),
                new THREE.Vector2(0.94, 0.65),
                new THREE.Vector2(0.86, 0.15),
                new THREE.Vector2(0.66, -0.62),
                new THREE.Vector2(0.0, -0.62)
            ];
            const cupMesh = new THREE.Mesh(new THREE.LatheGeometry(cupPoints, 48), cupMat);
            heroGroup.add(cupMesh);

            const rimMesh = new THREE.Mesh(new THREE.TorusGeometry(0.98, 0.032, 16, 48), goldRimMat);
            rimMesh.rotation.x = Math.PI / 2;
            rimMesh.position.y = 0.65;
            heroGroup.add(rimMesh);

            const coffeeMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.91, 0.88, 0.06, 40), coffeeLiquidMat);
            coffeeMesh.position.y = 0.48;
            heroGroup.add(coffeeMesh);

            const handleMesh = new THREE.Mesh(new THREE.TorusGeometry(0.42, 0.075, 16, 32, Math.PI * 1.15), cupMat);
            handleMesh.position.set(0.95, -0.05, 0);
            handleMesh.rotation.z = -Math.PI / 2.2;
            heroGroup.add(handleMesh);

            const saucerPoints = [
                new THREE.Vector2(0.0, -0.96),
                new THREE.Vector2(0.85, -0.96),
                new THREE.Vector2(1.48, -0.78),
                new THREE.Vector2(1.52, -0.73),
                new THREE.Vector2(0.82, -0.88),
                new THREE.Vector2(0.0, -0.88)
            ];
            const saucerMesh = new THREE.Mesh(new THREE.LatheGeometry(saucerPoints, 48), saucerMat);
            heroGroup.add(saucerMesh);

            const beansGroup = new THREE.Group();
            scene.add(beansGroup);

            const beanMat = new THREE.MeshStandardMaterial({ color: 0x3A2214, roughness: 0.45, metalness: 0.15 });
            const goldBeanMat = new THREE.MeshStandardMaterial({ color: 0xA67B5B, roughness: 0.3, metalness: 0.7 });

            const beans = [];
            const beanGeo = new THREE.SphereGeometry(0.14, 18, 14);
            beanGeo.scale(1.0, 1.38, 0.72);

            for (let i = 0; i < 24; i++) {
                const bean = new THREE.Mesh(beanGeo, i % 4 === 0 ? goldBeanMat : beanMat);
                const angle = (i / 24) * Math.PI * 2;
                const radius = 2.7 + (i % 4) * 0.85;
                bean.position.set(Math.cos(angle) * radius, ((i % 7) - 3) * 1.15, Math.sin(angle) * 2.2 - 1.2);
                bean.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, Math.random() * Math.PI);
                beansGroup.add(bean);
                beans.push({ mesh: bean, baseY: bean.position.y, speed: 0.4 + (i % 5) * 0.15, offset: i * 0.7 });
            }

            let targetScroll = window.scrollY;
            let currentScroll = window.scrollY;
            window.addEventListener('scroll', () => { targetScroll = window.scrollY; }, { passive: true });
            window.addEventListener('resize', () => {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });

            const clock = new THREE.Clock();
            function animate() {
                requestAnimationFrame(animate);
                const elapsed = clock.getElapsedTime();

                currentScroll += (targetScroll - currentScroll) * 0.06;
                const maxScroll = Math.max(document.body.scrollHeight - window.innerHeight, 1);
                const scrollProgress = currentScroll / maxScroll;

                const isMobile = window.innerWidth < 768;
                heroGroup.position.x = Math.sin(scrollProgress * Math.PI * 2.5) * (isMobile ? 1.15 : 2.95);
                heroGroup.position.y = Math.sin(elapsed * 1.2) * 0.12 - (scrollProgress * 0.4 - 0.2);
                heroGroup.rotation.y = scrollProgress * Math.PI * 4 + elapsed * 0.25;
                heroGroup.rotation.x = 0.28 + Math.sin(scrollProgress * Math.PI * 2) * 0.22;
                heroGroup.rotation.z = Math.cos(scrollProgress * Math.PI * 2) * 0.15;

                beansGroup.rotation.y = scrollProgress * Math.PI * 2.2 + elapsed * 0.08;
                beansGroup.position.y = (scrollProgress - 0.5) * 2.4;

                beans.forEach((b) => {
                    b.mesh.position.y = b.baseY + Math.sin(elapsed * b.speed + b.offset) * 0.18;
                    b.mesh.rotation.x += 0.008;
                    b.mesh.rotation.y += 0.01;
                });

                renderer.render(scene, camera);
            }
            animate();
        }

        window.addEventListener('load', initThreeScrollScene);
    </script>
